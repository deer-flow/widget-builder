{
  "name": "@deer-flow/widget-renderer",
  "version": "1.0.0",
  "type": "module",
  "typings": "./dist/types",
  "main": "./dist/index.js",
  "module": "./dist/es",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --build tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --config ../../config/eslint-config/prettier.config.mjs --write .",
    "format:check": "prettier --config ../../config/eslint-config/prettier.config.mjs --check .",
    "type-check": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@deer-flow/widget": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@widget-builder/eslint-config": "workspace:*",
    "@widget-builder/ts-config": "workspace:*",
    "eslint": "~9.39.1",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  }
}
