{
  "extends": "@widget-builder/ts-config/web.json",
  "compilerOptions": {
    "types": ["node", "react", "react-dom"],
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "./dist/types",
    "skipLibCheck": true,
    "rootDir": "./src",
    "outDir": "./dist/es"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
