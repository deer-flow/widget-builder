{
  "name": "@widget-builder/monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo watch dev --filter @widget-builder/app",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --config ./config/eslint-config/prettier.config.mjs --write .",
    "format:check": "prettier --config ./config/eslint-config/prettier.config.mjs --check .",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "deploy": "turbo run build && cd apps/widget-builder && pnpm run deploy"
  },
  "devDependencies": {
    "eslint": "~9.39.1",
    "prettier": "^3.6.2",
    "turbo": "^2.6.0"
  },
  "packageManager": "pnpm@10.11.1"
}
